# Instellingen van het portaal (factuurdashboard + mailsorteerder).
#
# Kopieer dit naar /etc/dekoning/facturen.env en vul de waarden in.
# Dit voorbeeld bevat alleen placeholders; echte sleutels komen NOOIT in de
# repo, in een logregel of in een commit.
#
#   install -m 600 -o root -g root deploy/facturen.env.voorbeeld /etc/dekoning/facturen.env
#   ${EDITOR:-nano} /etc/dekoning/facturen.env
#
# Rechten 600 root:root is genoeg: systemd leest dit bestand als root, vóór
# het de rechten van de dienst laat zakken. De dienst zelf hoeft er niet bij.
#
# Een koppeling die leeg blijft, slaat zijn stap over. Het dashboard start dan
# gewoon en zegt op de instellingenpagina wat er ontbreekt.

# -- Microsoft 365 (Graph, app-only) -------------------------------------
# Er bestaan twee routes om een app bij een mailbox te laten; gebruik er
# altijd precies één, nooit allebei:
#   a) Entra Application permissions Mail.ReadWrite + Mail.Send met admin
#      consent. Die gelden voor ÉLKE mailbox in de tenant, dus alleen
#      denkbaar in een tenant met één mailbox.
#   b) Exchange RBAC for Applications: de rechten gelden alleen binnen een
#      scope op één mailbox (deploy/Setup-MailboxScope.ps1).
# IN GEBRUIK: route b. De tenant wordt gedeeld met andere mailboxen en
# domeinen, dus toegang via de RBAC-scope op één mailbox
# (Scope-FactuurdashboardDKT, alleen info@dekoningtegelwerken.nl);
# nooit Entra Mail-rechten toevoegen.
# Met RBAC staat er geen roles-claim in het token; "Verbindingen testen"
# kijkt daarom echt in de mailbox.
# Dezelfde app leest de facturen, sorteert de Inbox en stuurt door.
MAIL_PROVIDER=m365
M365_TENANT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
M365_CLIENT_SECRET=
# De mailbox waarvan de facturen gelezen worden.
M365_MAILBOX=naam@voorbeeld.nl
# Pad onder Inbox. Eén map ("Facturen") of genest ("Facturen/2026").
M365_FOLDER=Facturen

# -- Claude (uitlezen van de facturen en sorteren van de mail) ----------
# Zonder sleutel worden facturen niet uitgelezen en sorteert de
# mailsorteerder alleen op regels en website-afzenders.
ANTHROPIC_API_KEY=
# Uitlezen van facturen. Standaard claude-sonnet-5-5.
CLAUDE_MODEL=claude-sonnet-5-5
# Sorteren van de mail: klein en goedkoop. Standaard claude-haiku-4-5.
SORT_MODEL=claude-haiku-4-5

# -- bunq (alleen lezen) --------------------------------------------------
# LET OP: een bunq API-key geeft zelf volledige toegang tot de rekening. Dat
# dit dashboard alleen leest, zit in de code, niet in de sleutel. Behandel
# deze regel als een bankpas.
BUNQ_API_KEY=
# production of sandbox
BUNQ_ENV=production
# Optioneel: alleen deze rekeningen meenemen, gescheiden door komma's.
# Leeg = alle actieve rekeningen.
BUNQ_ACCOUNT_IBANS=

# -- Portaal: inloggen met Microsoft (Entra SSO) -------------------------
# Aparte app registration "DKT Portaal" (delegated, alleen openid profile
# email, redirect https://cms.dekoningtegelwerken.nl/auth/callback, plus
# .../auth/uitgelogd). Zie deploy/CMS-INSTALLATIE.md.
# Pas als ALLE vijf hieronder gevuld zijn (en M365_TENANT_ID een GUID is),
# staat SSO aan en vervalt Basic Auth. Half ingevuld = Basic Auth, lokaal.
PORTAL_BASE_URL=https://cms.dekoningtegelwerken.nl
ENTRA_PORTAL_CLIENT_ID=
ENTRA_PORTAL_CLIENT_SECRET=
# Komma-gescheiden. Leeg = niemand komt binnen.
PORTAL_ALLOWED_EMAILS=
# Minstens 32 tekens: openssl rand -base64 48
SESSION_SECRET=

# Tegel Offertes: het offertebeheer met zijn eigen login.
OFFERTES_URL=https://de-koning-tegelwerken.offerteknop.nl/offertes/

# -- Basic Auth (alleen zolang SSO niet is ingesteld) ------------------------
# Dan is het portaal alleen op 127.0.0.1 bereikbaar. Zonder deze twee laat
# het niemand binnen (het antwoordt met een melding, het start wel).
# Wachtwoord genereren: openssl rand -base64 24
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# -- Mailsorteerder -------------------------------------------------------
# Elke zoveel minuten een controle van de Inbox (vangnet naast de webhook).
SORT_INTERVAL_MIN=5
# Geheim dat Microsoft bij elke notificatie meestuurt (clientState).
# Pas in gebruik als SSO aan staat en cms. publiek is; tot die tijd alleen
# polling. Maken: openssl rand -hex 32
GRAPH_WEBHOOK_SECRET=

# -- Rondes ---------------------------------------------------------------
# Hoe vaak er een factuurronde draait (mail, uitlezen, bunq, koppelen, doorsturen).
SYNC_INTERVAL_MIN=15

# Alleen voor het losse dashboard zonder portaal; in het portaal staat het
# factuurdashboard altijd onder /facturen.
BASIS_PAD=/facturen

# Poort op 127.0.0.1. Staat geregistreerd in /etc/handsfree/poorten.md.
FACTUREN_POORT=8132

# Waar database, PDF's en bunq_state.json komen te staan. Normaal leeg
# laten: systemd zet STATE_DIRECTORY op /var/lib/dekoning-facturen.
# DATA_DIR=/var/lib/dekoning-facturen
